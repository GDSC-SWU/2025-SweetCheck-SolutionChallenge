<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 앱 전체 테마 -->
    <style name="Theme.Solutionchallenge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF9800</item>
        <item name="colorPrimaryVariant">#F57C00</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#009688</item>
        <item name="colorSecondaryVariant">#00796B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor" tools:targetApi="l">#FF9800</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/nanum_variable</item>
    </style>

    <!-- 식사 타입 버튼 스타일 -->
    <style name="MealButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">#F5F5F5</item>
    </style>

    <!-- 탭 텍스트 스타일 -->
    <style name="tabTextSize" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="logoTextStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F77803</item>
    </style>

    <style name="FlatButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">#F77803</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="elevation">0dp</item>
    </style>

</resources>